#include <winver.h>
1 ICON "../../assets/topline.ico"
1 24 "topline.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,1,0,0
 PRODUCTVERSION 0,1,0,0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "Topline"
      VALUE "FileDescription", "Topline - notch hidup untuk Windows"
      VALUE "FileVersion", "0.1.0"
      VALUE "ProductName", "Topline"
      VALUE "ProductVersion", "0.1.0"
      VALUE "OriginalFilename", "topline.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
